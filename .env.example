# Server Configuration
PORT=5001
NODE_ENV=development

# PostgreSQL Connection
DATABASE_URL=postgresql://localhost:5432/outreach_dashboard
PGUSER=postgres
PGPASSWORD=postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=outreach_dashboard

# Local Ollama LLM Inference
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Frontend / Vite API Base URL
VITE_API_URL=http://localhost:5001

# Live Outbound Email Delivery (Optional: Leave blank for safe simulation mode)
# For Gmail: Use smtp.gmail.com with an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="Outreach Team <your_email@gmail.com>"

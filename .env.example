# Server Configuration
PORT=5001
NODE_ENV=development

# PostgreSQL Connection (Local or Supabase Pooler)
DATABASE_URL=postgresql://localhost:5432/outreach_dashboard
# For Supabase Cloud:
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Local Ollama LLM Inference
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Frontend / Vite API Base URL
VITE_API_URL=http://localhost:5001

# Live Outbound Email Delivery via Gmail (Generate an App Password at https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=cloudconsultancy.ad@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
SMTP_FROM="Cloud Consultancy" <cloudconsultancy.ad@gmail.com>

# Inbound Email Synchronization (IMAP for Gmail)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# Security & Dashboard Access (ADMIN_PASSWORD must be at least 12 characters)
ADMIN_PASSWORD=YourSecurePassword2026!
# SESSION_SECRET is mandatory — server will refuse to start without it (min 16 chars).
# Generate with: openssl rand -hex 32
SESSION_SECRET=your_32_character_random_session_secret_here
# CORS allowed origins (comma-separated). Used for browser routes and CSRF checks.
ALLOWED_ORIGINS=https://your-custom-domain.com
# Optional: legacy secret for verifying unsubscribe tokens signed before SESSION_SECRET rotation.
# Never used for signing new tokens. Set only if you have outstanding unsubscribe links.
LEGACY_UNSUBSCRIBE_SECRET=your_legacy_unsubscribe_secret_here

# Technical Audit Dashboard (TD) Webhook Integration
APP_URL=http://localhost:5001
TD_ENDPOINT_URL=http://localhost:5174/api/od/audit-request
TD_INBOUND_SECRET=your_td_inbound_secret_here
TD_CALLBACK_SECRET=your_td_callback_secret_here
OD_INTERNAL_API_KEY=your_od_internal_api_key_here
ALLOW_LOCAL_AUDIT_FALLBACK=true

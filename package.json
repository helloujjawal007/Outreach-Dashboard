{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"CLIENT,SERVER\" -c \"cyan.bold,magenta.bold\" \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "start": "tsx server/src/index.ts",
    "build": "vite build",
    "install:chrome": "npx -y @puppeteer/browsers install chrome@stable --path ./chrome-bin && npx -y @puppeteer/browsers install chrome-headless-shell@stable --path ./chrome-bin",
    "render:build": "npm run build && (npm run install:chrome || true)",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "db:migrate": "tsx server/src/db/migrate.ts",
    "db:seed": "tsx server/src/db/seed.ts",
    "postinstall": "node -e \"const fs=require('fs');const p='node_modules/whatsapp-rust-bridge/package.json';if(fs.existsSync(p)){const j=JSON.parse(fs.readFileSync(p));j.main='./dist/index.js';if(j.exports&&j.exports['.']){j.exports['.'].require='./dist/index.js';j.exports['.'].default='./dist/index.js';}fs.writeFileSync(p,JSON.stringify(j,null,2));}\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "imapflow": "^2.0.0",
    "lucide-react": "^0.446.0",
    "mailparser": "^3.9.23",
    "nodemailer": "^10.0.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.13",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.4.6",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "typescript-eslint": "^8.3.0"
  }
}
